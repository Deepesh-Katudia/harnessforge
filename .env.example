# MongoDB Atlas Hackathon Sandbox cluster (engine user needs read on sample_* and readWrite on harnessforge)
MONGODB_URI=mongodb+srv://USER:PASS@cluster.xxxx.mongodb.net/?retryWrites=true&w=majority
HF_DB=harnessforge

OPENROUTER_API_KEY=
VOYAGE_API_KEY=

# Optional LangSmith tracing
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=harnessforge

# Model routing (OpenRouter ids)
CHEAP_MODEL=meta-llama/llama-3.1-8b-instruct
STRONG_MODEL=openai/gpt-5.4-mini
META_MODEL=anthropic/claude-sonnet-5
